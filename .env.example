# LazyHire Environment Configuration

# App Configuration
PROJECT_NAME="LazyHire"
ENV="development"
DEBUG=true
API_V1_STR="/api/v1"
SECRET_KEY="supersecretkey-change-in-production"

# Server
HOST="127.0.0.1"
PORT=8000

# Database Configuration (PostgreSQL)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_password"
POSTGRES_DB="lazyhire_db"
DATABASE_URL="postgresql+asyncpg://postgres:postgres_password@localhost:5432/lazyhire_db"

# Redis & Celery
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/1"
CELERY_RESULT_BACKEND="redis://localhost:6379/2"

# Primary LLM Provider Config
PRIMARY_LLM_PROVIDER="openai"
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
DEEPSEEK_API_KEY=""
OLLAMA_BASE_URL="http://localhost:11434"

# Execution & Anti-Detection
BROWSER_HEADLESS=false
STOP_BEFORE_SUBMIT=true
CLICK_GAP_MIN=1.5
CLICK_GAP_MAX=4.0
